{
  "description": "Semantics-only mapping (no primitives). Use with the provided plugin script to create variables that alias existing primitive variables by name.",
  "modes": ["Light", "Dark"],
  "collections": [
    {
      "name": "Semantics – Surface",
      "variables": [
        { "name": "surface/app", "alias": { "Light": "neutral/0", "Dark": "neutral/900" } },
        { "name": "surface/layer/1", "alias": { "Light": "neutral/50", "Dark": "neutral/800" } },
        { "name": "surface/layer/2", "alias": { "Light": "neutral/100", "Dark": "neutral/700" } },
        { "name": "surface/brand", "alias": { "Light": "brand/600", "Dark": "brand/400" } },
  { "name": "surface/button/primary/default", "alias": { "Light": "brand/600", "Dark": "brand/500" } },
  { "name": "surface/button/primary/hover", "alias": { "Light": "brand/700", "Dark": "brand/400" } },
  { "name": "surface/button/primary/pressed", "alias": { "Light": "brand/800", "Dark": "brand/300" } },
        { "name": "surface/button/primary/disabled", "alias": { "Light": "neutral/200", "Dark": "neutral/600" } },
        { "name": "surface/button/secondary/default", "alias": { "Light": "neutral/100", "Dark": "neutral/700" } },
        { "name": "surface/button/secondary/hover", "alias": { "Light": "neutral/150", "Dark": "neutral/600" } },
        { "name": "surface/button/secondary/pressed", "alias": { "Light": "neutral/200", "Dark": "neutral/500" } },
        { "name": "surface/button/secondary/disabled", "alias": { "Light": "neutral/200", "Dark": "neutral/600" } },
        { "name": "surface/button/danger/default", "alias": { "Light": "error/400", "Dark": "error/400" } },
        { "name": "surface/button/danger/hover", "alias": { "Light": "error/600", "Dark": "error/600" } },
        { "name": "surface/button/danger/pressed", "alias": { "Light": "error/600", "Dark": "error/600" } },
        { "name": "surface/button/danger/disabled", "alias": { "Light": "neutral/200", "Dark": "neutral/600" } },
        { "name": "surface/field/default", "alias": { "Light": "neutral/0", "Dark": "neutral/800" } },
        { "name": "surface/field/disabled", "alias": { "Light": "neutral/100", "Dark": "neutral/700" } },
        { "name": "surface/field/invalid", "alias": { "Light": "error/50", "Dark": "error/50" } },
        { "name": "surface/status/success", "alias": { "Light": "success/100", "Dark": "success/600" } },
        { "name": "surface/status/warning", "alias": { "Light": "warning/100", "Dark": "warning/600" } },
        { "name": "surface/status/error", "alias": { "Light": "error/100", "Dark": "error/600" } },
        { "name": "surface/scrim/default", "value": { "Light": "rgba(0,0,0,0.40)", "Dark": "rgba(0,0,0,0.60)" } },
        { "name": "surface/selection", "alias": { "Light": "brand/100", "Dark": "brand/800" } }
      ]
    },
    {
      "name": "Semantics – Content",
      "variables": [
        { "name": "content/default", "alias": { "Light": "neutral/900", "Dark": "neutral/0" } },
        { "name": "content/muted", "alias": { "Light": "neutral/600", "Dark": "neutral/300" } },
        { "name": "content/inverse", "alias": { "Light": "neutral/0", "Dark": "neutral/900" } },
        { "name": "content/on/button-primary", "alias": { "Light": "neutral/0", "Dark": "neutral/0" } },
        { "name": "content/on/button-secondary", "alias": { "Light": "neutral/900", "Dark": "neutral/0" } },
        { "name": "content/on/button-danger", "alias": { "Light": "neutral/0", "Dark": "neutral/0" } },
        { "name": "content/on/status/success", "alias": { "Light": "success/700", "Dark": "success/50" } },
        { "name": "content/on/status/warning", "alias": { "Light": "warning/700", "Dark": "warning/50" } },
        { "name": "content/on/status/error", "alias": { "Light": "error/600", "Dark": "error/50" } },
        { "name": "content/link/default", "alias": { "Light": "brand/600", "Dark": "brand/400" } },
        { "name": "content/link/hover", "alias": { "Light": "brand/700", "Dark": "brand/300" } },
        { "name": "content/link/visited", "alias": { "Light": "brand/800", "Dark": "brand/200" } },
        { "name": "content/disabled", "alias": { "Light": "neutral/500", "Dark": "neutral/400" } }
      ]
    },
    {
      "name": "Semantics – Border",
      "variables": [
        { "name": "border/default", "alias": { "Light": "neutral/300", "Dark": "neutral/600" } },
        { "name": "border/subtle", "alias": { "Light": "neutral/200", "Dark": "neutral/500" } },
        { "name": "border/strong", "alias": { "Light": "neutral/400", "Dark": "neutral/400" } },
        { "name": "border/focus", "alias": { "Light": "brand/400", "Dark": "brand/300" } },
        { "name": "border/status/success", "alias": { "Light": "success/400", "Dark": "success/600" } },
        { "name": "border/status/warning", "alias": { "Light": "warning/400", "Dark": "warning/600" } },
        { "name": "border/status/error", "alias": { "Light": "error/400", "Dark": "error/600" } },
        { "name": "border/field/default", "alias": { "Light": "neutral/300", "Dark": "neutral/600" } },
        { "name": "border/field/hover", "alias": { "Light": "neutral/400", "Dark": "neutral/500" } },
        { "name": "border/field/focus", "alias": { "Light": "brand/400", "Dark": "brand/300" } },
        { "name": "border/field/error", "alias": { "Light": "error/400", "Dark": "error/400" } }
      ]
    },
    {
      "name": "Semantics – Overlay",
      "variables": [
        { "name": "overlay/light/hover", "value": { "Light": "rgba(0,0,0,0.04)", "Dark": "rgba(255,255,255,0.06)" } },
        { "name": "overlay/light/pressed", "value": { "Light": "rgba(0,0,0,0.10)", "Dark": "rgba(255,255,255,0.12)" } },
        { "name": "overlay/dark/hover", "value": { "Light": "rgba(255,255,255,0.08)", "Dark": "rgba(0,0,0,0.20)" } },
        { "name": "overlay/dark/pressed", "value": { "Light": "rgba(255,255,255,0.16)", "Dark": "rgba(0,0,0,0.32)" } }
      ]
    }
  ]
}
