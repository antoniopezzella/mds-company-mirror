{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "marsh-design-system",
  "homepage": "https://github.com/antoniopezzella/marsh-design-system",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn() utility",
      "description": "Tailwind class merging helper (clsx + tailwind-merge) — every MDS shadcn component depends on this.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        { "path": "src/lib/utils.ts", "type": "registry:lib" }
      ]
    },
    {
      "name": "mds-tokens",
      "type": "registry:lib",
      "title": "MDS design tokens",
      "description": "The 3-tier token system (primitives -> semantics -> roles) and getRoleColor() — the only color API MDS components use.",
      "files": [
        { "path": "src/tokens.ts", "type": "registry:lib" },
        { "path": "src/semantic-tokens.ts", "type": "registry:lib" },
        { "path": "src/theme/roles.ts", "type": "registry:lib" }
      ]
    },
    {
      "name": "theme-mode-context",
      "type": "registry:hook",
      "title": "useThemeMode",
      "description": "Light/dark mode React context — no external dependencies.",
      "files": [
