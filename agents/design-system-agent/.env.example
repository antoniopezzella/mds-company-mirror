# Model provider — AGENT_MODEL controls all subagents (they inherit it unless a
# subagent spec sets its own `model`). Pick one:
#
#   OpenAI (hosted, needs quota):        AGENT_MODEL=openai:gpt-5.5
#   Local via Ollama (no quota, free):   AGENT_MODEL=ollama:qwen3-coder:30b
#     Requires `ollama serve` running locally with that model pulled.
#
AGENT_MODEL=ollama:qwen3-coder:30b
OPENAI_API_KEY=

# Figma REST API personal access token (Figma account settings -> Personal access tokens).
# Separate from any MCP/plugin connection — this agent runs headless and needs its own.
FIGMA_ACCESS_TOKEN=
