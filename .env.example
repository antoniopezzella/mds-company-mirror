# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Figma (design-system agent — agents/design-system-agent/src/tools/figma.ts)
# A Personal Access Token from figma.com -> Settings -> Security.
# Scope it to the minimum you need; file read is usually enough.
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here

# Story UI Configuration
# Choose one: ANTHROPIC_API_KEY (Claude) | OPENAI_API_KEY | GEMINI_API_KEY
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# VITE_STORY_UI_PORT=4001

# Server Configuration
PORT=3333
APP_NAME=Marsh AI Assistant

# Directories
PUBLIC_DIR=public
DOCS_DIR=data/approved

# Security
ALLOWED_ORIGINS=http://localhost:3333,http://localhost:5173

# OpenTelemetry (optional - for observability)
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Environment
NODE_ENV=development
