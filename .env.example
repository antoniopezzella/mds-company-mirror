# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Figma — you probably do NOT need a token here.
#
#   Publishing Code Connect to Dev Mode   -> the "Figma Code Connect" GitHub
#                                            Actions workflow. The token is a
#                                            repository secret; nothing local.
#   Reading design files interactively    -> the Figma MCP server, which
#                                            authenticates as you. No token.
#   Consuming the design system           -> nothing. A Figma seat shows you
#                                            the published Dev Mode snippets;
#                                            that is the point of Code Connect.
#
# The ONE case that wants a token on disk is the headless agent
# (agents/design-system-agent/src/tools/figma.ts), which runs unattended and so
# cannot use the MCP connection. Set it in that package's own .env, not here.
#
# A Figma PAT is a *personal* credential carrying your full access to every
# file you can see — there is no narrow "read one library" scope. This repo
# leaked one from a committed .env (removed from tracking in 695d58c, still
# reachable in history), so treat a local Figma token as a last resort.
# FIGMA_ACCESS_TOKEN=

# Story UI Configuration
# Choose one: ANTHROPIC_API_KEY (Claude) | OPENAI_API_KEY | GEMINI_API_KEY
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# VITE_STORY_UI_PORT=4001

# Server Configuration
PORT=3333
APP_NAME=Marsh AI Assistant

# Directories
PUBLIC_DIR=public
DOCS_DIR=data/approved

# Security
ALLOWED_ORIGINS=http://localhost:3333,http://localhost:5173

# OpenTelemetry (optional - for observability)
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Environment
NODE_ENV=development
