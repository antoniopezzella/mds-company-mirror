{
  "files": [],
  // Solution-style config: `files: []` means these compilerOptions are unused
  // by `tsc -b` (each referenced project carries its own). They exist for
  // tools that read only the root tsconfig — notably Vercel, which
  // type-checks `api/` functions against it and otherwise reports TS2732 on
  // the handler's `knowledge-base.json` import.
  "compilerOptions": {
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    // Duplicated from tsconfig.app.json for the same "tools that read only the
    // root tsconfig" reason above — here it is react-docgen, which powers
    // Storybook's component manifest. It resolves imports by static analysis
    // against the ROOT tsconfig's paths, not Vite's aliases.
    //
    // ~~and therefore needs `baseUrl` — without it the manifest emitted 5 of 77
    // ui/ components with props instead of 70~~ — Refuted 2026-10-23. `baseUrl`
    // was removed (TypeScript 6 drops it; `paths` resolves relative to this
    // file since TS 5) and the manifest was rebuilt either side: 119 components,
    // 85 with props, 668 props extracted — IDENTICAL. The `paths` block is what
    // react-docgen needs; `baseUrl` was never the load-bearing half.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.api.json" }
  ]
}
