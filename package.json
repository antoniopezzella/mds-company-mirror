{
  "name": "mds-platform-b2b-2025",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "pretest": "node scripts/kill-storybook.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mcp-validate": "mcp-server validate --config mcp.config.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:clean": "rm -rf node_modules/.cache/storybook node_modules/.vite storybook-static",
    "storybook:deploy": "npm run build-storybook && npx gh-pages -d storybook-static",
    "docs:lint": "node scripts/lint-docs.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tokens:build": "node scripts/build-tokens.js",
    "tokens:diff": "node scripts/diff-tokens.js",
    "tokens:check": "npm run tokens:build && node scripts/diff-tokens.js --ci && npm run tokens:validate && npm run tokens:contrast:all",
    "tokens:validate": "node scripts/validate-tokens.js",
    "tokens:contrast": "node scripts/check-contrast.js",
    "tokens:contrast:all": "node scripts/check-contrast.js --all",
    "tokens:contrast:json": "node scripts/check-contrast.js --all --json",
    "tokens:contrast:info": "node scripts/check-contrast.js --all --include-informational",
    "tokens:contrast:badge": "node scripts/check-contrast.js --all --json > contrast-report.json && node scripts/generate-contrast-badge.js contrast-report.json",
    "roles:check": "node scripts/check-role-usage.js",
    "roles:check:strict": "node scripts/check-role-usage.js --strict",
    "roles:check:json": "node scripts/check-role-usage.js --json",
    "governance:report": "node scripts/report-governance.js",
    "governance:report:json": "node scripts/report-governance.js --json",
    "governance:report:strict": "node scripts/report-governance.js --strict --json",
    "governance:ci": "npm run tokens:build && npm run governance:report:strict",
    "governance:badge": "npm run governance:report:strict > governance-report.json && node scripts/generate-governance-badge.js governance-report.json",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "changelog:release": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "prepare": "husky",
    "build:global-css": "sass src/global.scss src/global.css --no-source-map",
    "release": "standard-version",
    "release:prerelease": "standard-version --prerelease rc",
    "figma:connect": "npx figma connect",
    "figma:publish": "npx figma connect publish",
    "figma:unpublish": "npx figma connect unpublish",
    "lighthouse": "node scripts/lighthouse-audit.js",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:upload": "lhci upload",
    "lighthouse:quick": "lighthouse http://localhost:5173 --output html --output-path ./lighthouse-quick-report.html --chrome-flags=\"--headless\"",
    "lighthouse:build": "npm run build && npm run preview & sleep 5 && LIGHTHOUSE_URL=http://localhost:4173 npm run lighthouse && pkill -f vite",
    "lighthouse:dev": "npm run dev & sleep 10 && npm run lighthouse && pkill -f vite",
    "deploy": "npm run tokens:build && npm run build-storybook && vercel --prod",
    "deploy:preview": "npm run tokens:build && npm run build-storybook && vercel",
    "deploy:tokens": "npm run tokens:build && vercel --prod",
    "vercel:build": "npm run tokens:build && npm run build-storybook",
    "clean": "rm -rf node_modules dist storybook-static .vite coverage",
    "clean:install": "npm run clean && npm install",
    "clean:ci": "npm run clean && npm ci",
    "fresh-start": "npm run clean:ci && npm run test && npm run build",
    "deps:check": "npm outdated || true",
    "deps:update": "npm update && npm audit fix",
    "security": "npm audit && npm audit fix",
    "workflow:local": "npm run clean:install && npm run security && npm test && npm run build",
    "workflow:ci": "npm ci && npm run security && npm test && npm run build && npm run build-storybook"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.4",
    "@mui/system": "^7.3.3",
    "@toolpad/core": "^0.16.0",
    "@types/react-router-dom": "^5.3.3",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.3",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.29.0",
    "@figma/code-connect": "^1.3.8",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/react": "^3.0.1",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-vitest": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "chrome-launcher": "^1.1.3",
    "conventional-changelog-cli": "^4.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.10",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.55.1",
    "postcss": "^8.5.6",
    "standard-version": "^9.5.0",
    "storybook": "^9.1.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
