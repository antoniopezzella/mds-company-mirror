{
  "name": "mds-platform-b2b-2025",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mcp-validate": "mcp-server validate --config mcp.config.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:clean": "rm -rf node_modules/.cache/storybook node_modules/.vite storybook-static && npm run storybook",
    "docs:lint": "node scripts/lint-docs.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
  "tokens:build": "node scripts/build-tokens.js",
  "tokens:diff": "node scripts/diff-tokens.js",
  "tokens:check": "npm run tokens:build && node scripts/diff-tokens.js --ci && npm run tokens:validate",
  "tokens:validate": "node scripts/validate-tokens.js"
    ,"prepare": "husky install"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.4",
    "@mui/system": "^7.3.3",
    "@toolpad/core": "^0.16.0",
    "@types/react-router-dom": "^5.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.3",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.29.0",
  "@storybook/addon-a11y": "^9.1.10",
  "@storybook/addon-vitest": "^9.1.10",
  "@storybook/addon-docs": "^9.1.10",
  "@storybook/react-vite": "^9.1.10",
  "@mdx-js/react": "^3.0.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.10",
    "globals": "^16.2.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.55.1",
  "storybook": "^9.1.10",
    "husky": "^9.0.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
