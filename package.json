{
  "name": "@antoniopezzella/marsh-design-system",
  "version": "0.8.0",
  "type": "module",
  "description": "Marsh Design System — React component library (shadcn/Radix + Tailwind) with governed design tokens. Published under a personal GitHub account as an explicit stopgap pending move to a Marsh/MMC GitHub org — see docs/SHADCN_MIGRATION_STATUS.md.",
  "repository": {
    "type": "git",
    "url": "https://github.com/antoniopezzella/marsh-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist-pkg/index.cjs",
  "module": "./dist-pkg/index.mjs",
  "types": "./dist-pkg/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-pkg/index.d.ts",
      "import": "./dist-pkg/index.mjs",
      "require": "./dist-pkg/index.cjs"
    },
    "./styles.css": "./dist-pkg/styles.css"
  },
  "files": [
    "dist-pkg",
    "README.package.md"
  ],
  "peerDependencies": {
    "@tanstack/react-table": "^9",
    "@tanstack/table-core": "^9",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:package": "vite build --config vite.lib.config.ts && npm run build:css && node scripts/copy-package-fonts.mjs && node scripts/check-package-types.js",
    "pkg:types:check": "node scripts/check-package-types.js",
    "pkg:types:selftest": "node scripts/check-package-types.js --selftest",
    "pretest": "node scripts/kill-storybook.js",
    "prestorybook": "node scripts/kill-storybook.js",
    "predev": "node scripts/cleanup-ports.js",
    "predev:all": "node scripts/cleanup-ports.js",
    "dev": "concurrently --kill-others --names \"VITE,GATEWAY\" -c \"cyan,magenta\" \"vite\" \"cd apps/gateway && npm run dev\"",
    "dev:frontend": "vite",
    "dev:gateway": "cd apps/gateway && npm run dev",
    "build": "tsc -b && vite build && npm run tokens:build",
    "build:gateway": "cd apps/gateway && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gateway:eval": "cd apps/gateway && npm run eval",
    "storybook": "storybook dev -p 6006",
    "story-ui": "story-ui start --port 4002",
    "build-storybook": "storybook build",
    "storybook:clean": "rm -rf node_modules/.cache/storybook node_modules/.vite storybook-static",
    "storybook:deploy": "npm run build-storybook && npx gh-pages -d storybook-static",
    "docs:lint": "node scripts/lint-docs.js && node scripts/check-docs-sprawl.js",
    "docs:check-sprawl": "node scripts/check-docs-sprawl.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "test:coverage:storybook": "vitest run --project storybook --coverage",
    "size": "size-limit",
    "test:dark": "vitest run --config vitest.dark.config.ts",
    "dark:check": "vitest run --config vitest.dark.config.ts --reporter=json --outputFile=dark-results.json; node scripts/check-dark-baseline.js dark-results.json",
    "dark:baseline": "vitest run --config vitest.dark.config.ts --reporter=json --outputFile=dark-results.json; node scripts/check-dark-baseline.js --write dark-results.json",
    "dark:selftest": "node scripts/check-dark-baseline.js --selftest",
    "icons:subset": "node scripts/subset-icons.mjs",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "tokens:build": "node scripts/build-tokens.js",
    "kb:build": "node scripts/build-knowledge-base.js",
    "tokens:diff": "node scripts/diff-tokens.js",
    "tokens:check": "npm run tokens:build && node scripts/diff-tokens.js --ci && npm run tokens:validate && npm run tokens:validate-dtcg && npm run tokens:contrast:all",
    "tokens:validate": "node scripts/validate-tokens.js",
    "tokens:validate-dtcg": "node scripts/validate-tokens-dtcg.js",
    "tokens:check-vars": "node scripts/check-token-variables.js",
    "tokens:check-vars:strict": "node scripts/check-token-variables.js --strict",
    "tokens:check-vars:selftest": "node scripts/check-token-variables.js --selftest",
    "tokens:fix-vars": "node scripts/check-token-variables.js --fix",
    "tokens:contrast": "node scripts/check-contrast.js",
    "tokens:contrast:all": "node scripts/check-contrast.js --all",
    "tokens:contrast:json": "node scripts/check-contrast.js --all --json",
    "tokens:contrast:info": "node scripts/check-contrast.js --all --include-informational",
    "tokens:contrast:badge": "node scripts/check-contrast.js --all --json > contrast-report.json && node scripts/generate-contrast-badge.js contrast-report.json",
    "tokens:contrast:selftest": "node scripts/check-contrast.js --selftest",
    "tokens:export-figma": "node scripts/export-figma-variables.js",
    "tokens:compare": "node scripts/compare-figma-tokens.js",
    "tokens:check-figma": "node scripts/check-figma-drift.js",
    "tokens:check-figma:selftest": "node scripts/check-figma-drift.js --selftest",
    "tokens:check-figma-semantic": "node scripts/check-figma-semantic-drift.js",
    "tokens:check-figma-semantic:selftest": "node scripts/check-figma-semantic-drift.js --selftest",
    "tokens:figma-to-dtcg": "node scripts/figma-to-dtcg.js",
    "tokens:diff-dtcg": "node scripts/diff-dtcg.js",
    "roles:check": "node scripts/check-role-usage.js",
    "roles:check:strict": "node scripts/check-role-usage.js --strict",
    "roles:check:json": "node scripts/check-role-usage.js --json",
    "varsync:check": "node scripts/check-token-vars-sync.js",
    "varsync:selftest": "node scripts/check-token-vars-sync.js --selftest",
    "zindex:check": "node scripts/check-z-index.js",
    "visual:build": "storybook build -o dist/storybook",
    "visual:capture": "node scripts/visual-baseline.js capture visual-baseline/light",
    "visual:capture:dark": "node scripts/visual-baseline.js capture visual-baseline/dark --dark",
    "visual:compare": "node scripts/visual-baseline.js compare",
    "chromatic": "chromatic --build-script-name=build-storybook --exit-zero-on-changes",
    "gates:selftest": "node scripts/check-gate-selftests.js",
    "metrics:selftest": "node scripts/check-metric-selftests.js",
    "radius:check": "node scripts/check-radius.js",
    "composition:check": "node scripts/check-composition.js",
    "composition:check:strict": "node scripts/check-composition.js --strict",
    "composition:check:json": "node scripts/check-composition.js --json",
    "governance:report": "node scripts/report-governance.js",
    "governance:report:json": "node scripts/report-governance.js --json",
    "governance:report:strict": "node scripts/report-governance.js --strict --json",
    "governance:ci": "npm run tokens:build && npm run typecheck:tests && npm run governance:report:strict && npm run roles:check:strict && npm run props:check:strict && npm run composition:check:strict && npm run zindex:check && npm run radius:check && npm run varsync:check && npm run varsync:selftest && npm run tokens:check-vars:strict && npm run tokens:check-vars:selftest && npm run tokens:contrast:selftest && npm run tokens:check-figma:selftest && npm run tokens:check-figma-semantic:selftest && npm run pkg:css:selftest && npm run pkg:types:selftest && npm run deprecations:check && npm run registry:check && npm run gates:selftest && npm run metrics:selftest && npm run dark:selftest",
    "governance:badge": "npm run governance:report:strict > governance-report.json && node scripts/generate-governance-badge.js governance-report.json",
    "automation:validate": "node scripts/automation/ai-design-validator.js",
    "automation:validate:test": "node scripts/automation/ai-design-validator.js --test",
    "automation:match": "node scripts/automation/match-mds-variables.js",
    "automation:match:test": "node scripts/automation/match-mds-variables.js --test",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "changelog:release": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "prepare": "husky",
    "build:global-css": "sass src/global.scss src/global.css --no-source-map",
    "release": "MDS_ALLOW_MAIN_COMMIT=1 commit-and-tag-version",
    "release:prerelease": "MDS_ALLOW_MAIN_COMMIT=1 commit-and-tag-version --prerelease rc",
    "figma:connect": "npx figma connect",
    "figma:publish": "npx figma connect publish",
    "figma:unpublish": "npx figma connect unpublish",
    "lighthouse": "node scripts/lighthouse-audit.js",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:upload": "lhci upload",
    "lighthouse:quick": "lighthouse http://localhost:5173 --output html --output-path ./lighthouse-quick-report.html --chrome-flags=\"--headless\"",
    "lighthouse:build": "npm run build && npm run preview & sleep 5 && LIGHTHOUSE_URL=http://localhost:4173 npm run lighthouse && pkill -f vite",
    "lighthouse:dev": "npm run dev & sleep 10 && npm run lighthouse && pkill -f vite",
    "deploy": "npm run tokens:build && npm run build-storybook && vercel --prod",
    "deploy:preview": "npm run tokens:build && npm run build-storybook && vercel",
    "deploy:tokens": "npm run tokens:build && vercel --prod",
    "clean": "rm -rf node_modules dist storybook-static .vite coverage",
    "clean:install": "npm run clean && npm install",
    "clean:ci": "npm run clean && npm ci",
    "fresh-start": "npm run clean:ci && npm run test && npm run build",
    "deps:check": "npm outdated || true",
    "deps:update": "npm update && npm audit fix",
    "security": "npm audit && npm audit fix",
    "workflow:local": "npm run clean:install && npm run security && npm test && npm run build",
    "workflow:ci": "npm ci && npm run security && npm test && npm run build && npm run build-storybook",
    "storybook-with-ui": "concurrently \"npm run storybook\" \"npm run story-ui\"",
    "build:css": "tailwindcss -c tailwind.package.config.js -i src/styles.package.css -o dist-pkg/styles.css --minify && node scripts/check-package-css.js",
    "pkg:css:selftest": "node scripts/check-package-css.js --selftest",
    "props:check": "node scripts/check-prop-vocab.js",
    "props:check:strict": "node scripts/check-prop-vocab.js --strict",
    "props:check:json": "node scripts/check-prop-vocab.js --json",
    "deprecations:check": "node scripts/check-deprecations.js",
    "deprecations:check:json": "node scripts/check-deprecations.js --json",
    "ds:score": "node scripts/ds-health-score.js",
    "ds:score:record": "node scripts/ds-health-score.js --record",
    "ds:compare": "node scripts/ds-health-score.js --compare",
    "ds:backfill": "node scripts/ds-health-score.js --backfill --weeks 26",
    "stories:audit": "node scripts/audit-stories.js",
    "a11y:gate:check": "node scripts/check-a11y-gate.js",
    "registry:check": "node scripts/check-registry.js",
    "registry:suggest": "node scripts/check-registry.js --suggest",
    "registry:fix": "node scripts/check-registry.js --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-aspect-ratio": "^1.1.13",
    "@radix-ui/react-avatar": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-collapsible": "^1.1.18",
    "@radix-ui/react-context": "^1.2.0",
    "@radix-ui/react-context-menu": "^2.3.5",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-hover-card": "^1.1.21",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-menubar": "^1.1.22",
    "@radix-ui/react-navigation-menu": "^1.2.20",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-progress": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.4.5",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slider": "^1.4.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-toast": "^1.2.21",
    "@radix-ui/react-toggle": "^1.1.16",
    "@radix-ui/react-toggle-group": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.16.0",
    "material-symbols": "^0.48.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.71",
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.29.0",
    "@figma/code-connect": "^1.4.3",
    "@gsap/react": "^2.1.2",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/react": "^3.0.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.4",
    "@mui/system": "^7.3.3",
    "@mui/x-data-grid": "^8.27.5",
    "@size-limit/file": "^14.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/table-core": "^9.2.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.0.0",
    "@tpitre/story-ui": "^4.16.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vercel/node": "^5.8.19",
    "@vimeo/player": "^2.30.4",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "ai": "^7.0.68",
    "autoprefixer": "^10.5.0",
    "chromatic": "^11.29.0",
    "chrome-launcher": "^1.1.3",
    "commit-and-tag-version": "^13.2.1",
    "concurrently": "^9.2.1",
    "conventional-changelog-cli": "^4.1.0",
    "dompurify": "^3.4.15",
    "eslint": "^9.29.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^16.2.0",
    "gsap": "^3.13.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lenis": "^1.3.11",
    "lighthouse": "^12.8.2",
    "marked": "^18.0.5",
    "ollama": "^0.6.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.55.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.15",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-live": "^4.1.8",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sass": "^1.104.1",
    "size-limit": "^14.2.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  },
  "overrides": {
    "@exodus/bytes": "1.14.1"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
