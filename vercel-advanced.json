{
  "version": 2,
  "name": "marsh-design-system",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "storybook-static/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/design-tokens/(.*)",
      "dest": "/dist/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/storybook-static/$1"
    }
  ],
  "functions": {
    "src/api/tokens.js": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "STORYBOOK_ENVIRONMENT": "vercel"
  },
  "regions": ["iad1"],
  "github": {
    "enabled": true,
    "autoAlias": true
  }
}