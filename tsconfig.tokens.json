{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": ".tmp-token-build",
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "files": [
    "src/tokens.ts",
    "src/spacing.ts",
    "src/shadows.ts",
    "src/semantic-tokens.ts",
    "src/theme/roles.ts"
  ]
}