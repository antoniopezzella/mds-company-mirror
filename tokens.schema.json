{
  "$id": "https://example.com/design-tokens.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Tokens Artifact",
  "type": "object",
  "required": ["meta", "color", "spacing", "shadows", "semantic"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["generated", "version", "source"],
      "properties": {
        "generated": { "type": "string" },
        "version": { "type": "string" },
        "source": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "color": {
      "type": "object",
      "patternProperties": {
        ".*": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$" }
      },
      "additionalProperties": false
    },
    "spacing": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "shadows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "value", "usage"],
        "properties": {
          "level": { "type": "number", "minimum": 0 },
          "value": { "type": "string" },
          "usage": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "semantic": {
      "type": "object",
      "properties": {
        "color": {
          "type": "object",
          "patternProperties": {
            ".*": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "required": ["color"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
