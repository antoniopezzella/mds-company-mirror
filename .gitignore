# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Keep built token artifacts under version control
# (Storybook static build still ignored separately)
# `dist/*`, not `dist`. Git cannot re-include a file whose parent DIRECTORY is
# excluded, so the three negations below never actually worked against a bare
# `dist` rule — those artifacts are tracked only because they were force-added
# once, and `git add dist/tokens.json` failed with "paths are ignored by one of
# your .gitignore files". That broke releases: commit-and-tag-version bumps the
# version stamped inside dist/tokens.json and then could not stage it.
# Excluding the directory's contents instead lets the negations apply.
dist/*
dist-ssr
dist-pkg
!dist/tokens.json
!dist/theme.css
!dist/tokens.tokens.json
*.local

# Transient, fully-derived DTCG token source Style Dictionary reads from —
# regenerated fresh every `tokens:build`, nothing else consumes it.
.tmp-token-build/tokens-dtcg/

# Environment variables (secrets)
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*storybook.log
storybook-static

# Lighthouse reports
lighthouse-reports/
lighthouse-quick-report.html
.lighthouseci/
lhci-data/
.vercel

# Local Netlify folder
.netlify

src/stories/generated
.story-ui-history/

# Test coverage output — fully derived, regenerated on every
# `npm run test:coverage` run, was accidentally tracked previously.
coverage/

# Generated by `npm run kb:build` from apps/gateway/data/approved/*.md —
# vercel.json's buildCommand regenerates this before every deploy, so
# committing it risks it going stale against the source markdown.
api/_data/

# Generated reports — regenerate with the *:badge / lighthouse scripts. These
# were tracked, so any two people running them locally got conflicting diffs.
contrast-report.json
governance-report.json
lighthouse-*.json
lighthouse-*.html

# Storybook deploy output, committed once by accident (201 files, 11MB)
marsh-design-system-deploy/

# Agent proposals. The task agents in .claude/agents/ are propose-only: they
# apply a change, measure whether the ds:score metric actually moved, revert,
# and leave a patch here. Gitignored because a proposal is not a decision —
# a human applies it with `git apply`.
.agent-proposals/
