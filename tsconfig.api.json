{
  // Serverless/Edge functions under `api/`. These were previously covered by
  // NO tsconfig at all — `tsc -b` only referenced tsconfig.app.json ("src")
  // and tsconfig.node.json ("vite.config.ts"), so nothing type-checked this
  // directory locally or in CI, and the only type feedback came from
  // Vercel's own build log (where errors are non-fatal, because Edge
  // functions are bundled with esbuild, which transpiles without checking).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The handler imports its knowledge base directly as JSON.
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": ["api"]
}
