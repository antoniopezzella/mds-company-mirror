# ─────────────────────────────────────────────────────────────────────────
# Branch discipline. Runs FIRST so it fails in milliseconds, before npm.
#
# Why a hook and not an instruction: CLAUDE.md has said "if on the default
# branch, branch first" for a while, and on 2026-10-07 an agent session
# committed to main four times anyway. That is not carelessness, it is the
# documented decay of instructions over a long session — guidance that governs
# the first few turns gets violated after ~30 tool calls, when it is far from
# the model's attention. Claude Code's own docs draw the same conclusion:
# "Claude treats them as context, not enforced configuration. To block an
# action regardless of what Claude decides, use a hook instead."
#
# main deploys to production, so the cost of the drift is real.
#
# Deliberate escape hatch — a release commit on main is legitimate:
#   MDS_ALLOW_MAIN_COMMIT=1 git commit ...
# commit-and-tag-version needs it, so `npm run release` sets it itself.
# ─────────────────────────────────────────────────────────────────────────
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"

# Skip while git is mid-operation: a rebase, merge, cherry-pick or bisect onto
# main is not someone casually committing to it, and blocking those strands the
# user in a half-finished state that is harder to get out of than it was to
# get into.
git_dir="$(git rev-parse --git-path . 2>/dev/null)"
in_progress=0
for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD BISECT_LOG REVERT_HEAD; do
  [ -e "$git_dir/$marker" ] && in_progress=1
done

if [ "$in_progress" -eq 0 ] && [ -z "$MDS_ALLOW_MAIN_COMMIT" ]; then
  case "$branch" in
    main|master)
      echo ""
      echo "✗ Refusing to commit directly to '$branch'."
      echo ""
      echo "  main deploys to production. Put this work on a branch:"
      echo ""
      echo "      git switch -c <type>/<short-description>"
      echo "      git commit ..."
      echo ""
      echo "  Your staged changes are untouched — switching branches keeps them."
      echo ""
      echo "  Genuinely need to commit on $branch (a release, say)?"
      echo ""
      echo "      MDS_ALLOW_MAIN_COMMIT=1 git commit ..."
      echo ""
      exit 1
      ;;
  esac
fi

# Run docs lint (fast fail) and token build to keep artifact aligned
# Note: unit tests run in CI — local test env has a jsdom/ESM compatibility issue
npm run docs:lint || exit 1
npm run tokens:build || exit 1
