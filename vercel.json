{
  "buildCommand": "storybook build --config-dir .storybook",
  "outputDirectory": "storybook-static",
  "framework": "vite",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control", 
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tokens.json",
      "destination": "/dist/tokens.json"
    },
    {
      "source": "/theme.css", 
      "destination": "/dist/theme.css"
    }
  ]
}
